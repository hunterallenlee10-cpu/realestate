---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';

export interface HeroVideoSource {
  src: string;
  type: string;
  /** Optional media query, e.g. '(max-width: 47.99rem)' for a lighter mobile file */
  media?: string;
}

/** "Now showing" caption changes as the film cuts between places (seconds into the loop). */
export interface HeroCaption {
  from: number;
  text: string;
}

interface Props {
  poster: ImageMetadata;
  posterAlt: string;
  posterFocus?: string;
  video?: HeroVideoSource[] | null;
  /** Caption for the poster / first shot (also the no-JS and reduced-motion caption) */
  nowShowing: string;
  captions?: HeroCaption[];
  kicker?: string;
}

const { poster, posterAlt, posterFocus, video, nowShowing, captions, kicker } = Astro.props;
const hasVideo = Boolean(video && video.length);
const posterImage = hasVideo
  ? await getImage({ src: poster, width: 1920, format: 'webp', quality: 68 })
  : null;
---

{posterImage && <link rel="preload" as="image" href={posterImage.src} fetchpriority="high" />}

<section class="hero" data-hero data-surface="dark" aria-labelledby="hero-title">
  <div class="hero__media">
    {
      hasVideo && posterImage ? (
        <>
          <!-- Sources attach after page load (scripts/hero.ts) so the film never competes with
               the poster, fonts or CSS; reduced-motion and Save-Data visitors keep the poster. -->
          <video
            class="hero__video graded"
            muted
            loop
            playsinline
            preload="none"
            poster={posterImage.src}
            disablepictureinpicture
            disableRemotePlayback
            aria-hidden="true"
            data-hero-video
          >
            {video!.map((s) => (
              <source data-src={s.src} type={s.type} media={s.media} />
            ))}
          </video>
        </>
      ) : (
        <Photo
          src={poster}
          alt={posterAlt}
          ratio="fill"
          sizes="100vw"
          widths={[640, 960, 1280, 1600, 1920, 2400].filter((w) => w <= poster.width)}
          focus={posterFocus}
          kenburns="loop"
          quality={52}
          eager
        />
      )
    }
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__content grid">
    <div class="hero__copy">
      <!-- The hero intro is pure CSS (global.css › intro-line / intro-fade) so it starts at first paint. -->
      <h1 id="hero-title" class="display hero__title">
        <span class="intro-line"><span style="--i: 0">Fredericksburg,</span></span>
        <span class="intro-line"><span style="--i: 1"><em>known by heart.</em></span></span>
      </h1>
      {kicker && <p class="label hero__kicker intro-fade" style="--d: 700ms">{kicker}</p>}
    </div>

    <div class="hero__now intro-fade" style="--d: 1000ms">
      <p class="label hero__now-label">Now showing</p>
      <p class="hero__place" data-hero-place data-captions={hasVideo && captions ? JSON.stringify(captions) : undefined}>
        {nowShowing}
      </p>
      <button class="hero__toggle" type="button" aria-label="Pause background motion" data-hero-toggle>
        <Icon name="pause" class="hero__icon-pause" />
        <Icon name="play" class="hero__icon-play" />
        <span data-hero-toggle-text>Pause</span>
      </button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    background: var(--ink);
    color: var(--ivory);
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__media :global(.frame) {
    background: var(--ink);
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Legibility scrim for the nav (top) and headline (bottom) — functional, not decorative.
     Tuned against the film's brightest sky frames: nav text stays ≥ 4.5:1 (qa/hero-contrast.*). */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to bottom,
        rgb(20 18 15 / 0.72) 0,
        rgb(20 18 15 / 0.62) 6.5rem,
        rgb(20 18 15 / 0.2) 12rem,
        rgb(20 18 15 / 0) 17rem
      ),
      linear-gradient(to top, rgb(20 18 15 / 0.8), rgb(20 18 15 / 0.5) 34%, rgb(20 18 15 / 0.16) 56%, rgb(20 18 15 / 0) 70%);
  }

  .hero__content {
    position: absolute;
    inset: auto 0 0;
    align-items: end;
    padding-bottom: clamp(1.75rem, 5vh, 3.75rem);
  }

  .hero__copy {
    grid-column: 1 / span 8;
  }

  .hero__kicker {
    margin-top: clamp(1.25rem, 3vh, 2rem);
  }

  .hero__title {
    /* capped by viewport height so short laptop screens keep the headline in the scrim */
    font-size: min(var(--step-5), 15.5vh);
    line-height: 0.9;
    text-wrap: balance;
  }

  .hero__now {
    grid-column: 9 / -1;
    justify-self: end;
    text-align: right;
    padding-bottom: 0.35rem;
  }

  .hero__now-label {
    color: rgb(247 243 236 / 0.82);
  }

  .hero__place {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-style: italic;
    line-height: 1.2;
    text-wrap: balance;
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.6s var(--ease-out);
  }

  .hero__place[data-swapping] {
    opacity: 0;
    transform: translateY(0.35em);
  }

  .hero__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    margin-top: 0.6rem;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hero__toggle :global(.icon) {
    width: 1rem;
    height: 1rem;
  }

  .hero__toggle :global(.hero__icon-play) {
    display: none;
  }

  .hero[data-paused='true'] .hero__toggle :global(.hero__icon-play) {
    display: block;
  }

  .hero[data-paused='true'] .hero__toggle :global(.hero__icon-pause) {
    display: none;
  }

  .hero :focus-visible {
    outline-color: var(--ivory);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__toggle {
      display: none;
    }
  }

  @media (max-width: 47.99rem) {
    .hero__copy,
    .hero__now {
      grid-column: 1 / -1;
    }

    .hero__now {
      justify-self: start;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 0.9rem;
      margin-top: 1.5rem;
      padding-top: 1rem;
      border-top: 1px solid rgb(247 243 236 / 0.3);
      text-align: left;
    }

    .hero__place {
      margin-top: 0;
    }

    .hero__toggle {
      margin: 0 0 0 auto;
    }


  }
</style>
