---
/**
 * Every photograph goes through here: AVIF/WebP with responsive widths, the
 * shared warm grade, a fixed aspect ratio (no layout shift) and optional motion:
 *   reveal="wipe"   — clip-path wipe as it enters the viewport
 *   kenburns="scroll" — slow scroll-linked zoom (large images)
 *   kenburns="loop"   — slow time-based zoom (hero)
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: 'letterbox' | 'landscape' | 'wide' | 'portrait' | 'tall' | 'square' | 'native' | 'fill';
  sizes: string;
  widths?: number[];
  focus?: string;
  reveal?: 'wipe';
  kenburns?: 'scroll' | 'loop';
  eager?: boolean;
  graded?: boolean;
  /** AVIF/WebP quality — full-bleed heroes sit under a scrim and can go lower */
  quality?: number;
  class?: string;
  imgClass?: string;
}

const {
  src,
  alt,
  ratio = 'landscape',
  sizes,
  widths,
  focus,
  reveal,
  kenburns,
  eager = false,
  graded = true,
  quality = 72,
  class: className,
  imgClass,
} = Astro.props;

const defaultWidths = [480, 800, 1200, 1600, 2000, 2400].filter((w) => w <= src.width);
if (!defaultWidths.includes(src.width) && src.width < 2400) defaultWidths.push(src.width);
const nativeRatio = `${src.width} / ${src.height}`;
---

<div
  class:list={[
    'frame',
    graded && 'graded',
    ratio !== 'native' && ratio !== 'fill' && `ratio-${ratio}`,
    ratio === 'fill' && 'frame--fill',
    className,
  ]}
  style={ratio === 'native' ? `aspect-ratio: ${nativeRatio}` : undefined}
  data-reveal={reveal}
>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths ?? defaultWidths}
    sizes={sizes}
    quality={quality}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding={eager ? 'auto' : 'async'}
    class:list={[kenburns === 'loop' && 'ken-burns', imgClass]}
    style={focus ? `object-position: ${focus}` : undefined}
    data-kenburns={kenburns === 'scroll' ? '' : undefined}
  />
</div>

<style>
  .frame--fill {
    position: absolute;
    inset: 0;
  }
</style>
