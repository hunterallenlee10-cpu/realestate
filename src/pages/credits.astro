---
import Base from '../layouts/Base.astro';
import { placeCredits } from '../data/places';
import { featured, moreListings } from '../data/listings';
import { heroVideoCredit } from '../data/credits';
---

<Base title="Photo credits — Kelly Robertson" headerMode="solid" hasContact={false}>
  <section class="credits grid" aria-labelledby="credits-title">
    <p class="label credits__kicker">Credits</p>
    <h1 id="credits-title" class="display credits__title">Photo <em>credits</em></h1>

    <div class="credits__body">
      <h2 class="label label--muted">Listing photography</h2>
      <ul role="list">
        <li>
          {featured.street}, {featured.city} — photography by {featured.photographer} (listing tour), courtesy of the
          listing. Listed by {featured.listedBy}.
        </li>
        {
          moreListings.map((l) => (
            <li>
              {l.name ? `${l.name}, ` : ''}
              {l.street}, {l.city} — {l.treatment === 'photo' ? 'listing tour photography' : 'Bright MLS IDX image'},
              courtesy of the listing. Listed by {l.listedBy}.
            </li>
          ))
        }
      </ul>
      <p class="muted">
        Listing photographs are used here for a private presentation only; usage rights must be confirmed with the
        listing agents and photographers before this site is published.
      </p>

      <h2 class="label label--muted">Portrait and brand marks</h2>
      <ul role="list">
        <li>Portrait of Kelly Robertson and the Coldwell Banker Elite logo — from Kelly’s current Coldwell Banker site.</li>
      </ul>

      {
        heroVideoCredit && (
          <>
            <h2 class="label label--muted">Homepage film</h2>
            <ul role="list">
              <li set:html={heroVideoCredit} />
            </ul>
          </>
        )
      }

      <h2 class="label label--muted">Fredericksburg &amp; the region</h2>
      {
        placeCredits.length ? (
          <ul role="list">
            {placeCredits.map((c) => (
              <li>
                <a href={c.sourceUrl}>{c.title}</a> — {c.author}.{' '}
                {c.licenseUrl ? <a href={c.licenseUrl}>{c.license}</a> : c.license}.
                {c.note && <span class="muted"> {c.note}</span>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="placeholder">[Place photo credits pending]</p>
        )
      }
      <p class="muted">Photographs share a light warm color grade applied in the browser; files are otherwise unaltered apart from resizing and cropping for layout.</p>
    </div>
  </section>
</Base>

<style>
  .credits {
    padding-top: calc(var(--header-h) + clamp(3rem, 8vw, 7rem));
    padding-bottom: clamp(5rem, 10vw, 9rem);
    row-gap: 1.5rem;
    align-items: start;
  }

  .credits__kicker {
    grid-column: 1 / -1;
    color: var(--brick);
  }

  .credits__title {
    grid-column: 1 / -1;
    font-size: var(--step-5);
    margin-bottom: 2rem;
  }

  .credits__body {
    grid-column: 3 / span 8;
    display: grid;
    gap: 1.1rem;
    font-size: 0.9375rem;
  }

  .credits__body h2 {
    margin-top: 2rem;
  }

  .credits__body ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding-left: 1.1em;
  }

  @media (max-width: 63.99rem) {
    .credits__body {
      grid-column: 1 / -1;
    }
  }
</style>
