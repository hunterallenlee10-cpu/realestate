---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Contact from '../components/Contact.astro';
import portrait from '../assets/kelly/kelly-robertson-portrait.jpg';
import { agent, brokerage } from '../data/site';
import { aboutRiver } from '../data/places';

// Kelly's own bio from her current site, split into paragraphs and lightly
// copy-edited (grammar only). Marked as a draft for her approval.
const bio = [
  'My family has been blessed with calling Virginia home for generations. Growing up with Fredericksburg as our home base, I have a vast knowledge of our region and all it has to offer. If you’re looking to make a move in our region, put my proven track record to work for you!',
  'Integrity and hard work are my core values. I take great pride in being your greatest advocate and always keeping your interests as my top priority. I strive to make the process enjoyable and stress-free with my experience as both a buyer’s and a seller’s agent.',
  'I began my career as a marketing director for a builder in Fairfax, and moved into the residential mortgage sector a few years later. After the experience of purchasing our second home, I decided to become a real estate agent — I first became a Virginia REALTOR® in 2005. I’m also an investor, with both mid- and long-term rentals. Whether you’re buying, selling or investing, I’m here to help you achieve your real estate goals.',
  'As a Coldwell Banker Elite agent, I have cutting-edge technology tools at my fingertips to help you with the best outcome on a purchase, or the best marketing strategy for the sale of your particular home. I look forward to hearing from you, and to helping you successfully navigate your real estate goals.',
];

const path = [
  { what: 'Marketing director', where: 'A home builder in Fairfax' },
  { what: 'Residential mortgage', where: 'A few years later' },
  { what: 'Our second home', where: 'The purchase that led to real estate' },
  { what: 'Virginia REALTOR®', where: `Licensed since ${agent.since}` },
  { what: 'Investor', where: 'Mid- and long-term rentals' },
  { what: brokerage.name, where: `${brokerage.office} office` },
];
---

<Base
  title="About Kelly Robertson — Coldwell Banker Elite, Fredericksburg"
  description="Kelly Robertson has called Fredericksburg home base her whole life. Virginia REALTOR® since 2005, Military Relocation Professional, Coldwell Banker Elite."
  headerMode="solid"
>
  <section class="ahero grid" aria-labelledby="about-title">
    <p class="label ahero__kicker" data-reveal="fade">About Kelly</p>
    <h1 id="about-title" class="display ahero__title" data-reveal="lines">
      Fredericksburg has always been <em>home base.</em>
    </h1>
    <div class="ahero__portrait">
      <Photo
        src={portrait}
        alt="Kelly Robertson smiling outdoors, with the water behind her."
        ratio="portrait"
        sizes="(max-width: 47.99rem) 70vw, 28vw"
        widths={[portrait.width]}
        focus="50% 30%"
        reveal="wipe"
        eager
      />
      <p class="ahero__cap label label--muted">
        {agent.name} · {agent.title}
        <br /><span class="placeholder">[High-resolution portrait needed]</span>
      </p>
    </div>
  </section>

  <Photo
    src={aboutRiver.src}
    alt={aboutRiver.alt}
    ratio="letterbox"
    sizes="100vw"
    widths={[640, 960, 1280, 1600, 2000, 2400]}
    focus={aboutRiver.focus}
    reveal="wipe"
    kenburns="scroll"
    class="aletterbox"
  />
  <p class="wrap aletterbox__cap label label--muted">{aboutRiver.caption}</p>

  <section class="astory grid" aria-labelledby="story-title">
    <h2 id="story-title" class="label label--muted astory__label" data-reveal="fade">In her words</h2>
    <div class="astory__body">
      {
        bio.map((p, i) => (
          <p class:list={['astory__p', i === 0 && 'astory__p--lead serif']} data-reveal="fade">
            {p}
          </p>
        ))
      }
      <p class="astory__sign serif" data-reveal="fade"><em>— Kelly</em></p>
      <p><span class="placeholder">[Kelly’s current bio, lightly edited — for her approval]</span></p>
    </div>
  </section>

  <section class="apath" aria-labelledby="path-title">
    <div class="grid apath__head">
      <p class="label label--muted apath__label" data-reveal="fade">The path here</p>
      <h2 id="path-title" class="display apath__title" data-reveal="lines">How Kelly got <em>here.</em></h2>
    </div>
    <ol class="apath__list grid" role="list">
      {
        path.map((step, i) => (
          <li class="apath__step" data-reveal="fade">
            <span class="label apath__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="serif apath__what">{step.what}</span>
            <span class="apath__where muted">{step.where}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="amil on-ink" aria-labelledby="mil-title">
    <div class="grid">
      <p class="label label--muted amil__label" data-reveal="fade">{agent.designation}</p>
      <h2 id="mil-title" class="display amil__title" data-reveal="lines">For military <em>families</em></h2>
      <div class="amil__text" data-reveal="fade">
        <p class="lead">
          Kelly is a certified Military Relocation Professional with a degree in Business. As part of a military
          family, she understands the many challenges of a PCS move and relocating — and she’ll be there each step
          of the way.
        </p>
        <p class="muted">
          Fredericksburg sits within reach of Marine Corps Base Quantico to the north and Naval Support Facility
          Dahlgren to the east — and Kelly knows the neighborhoods in between.
        </p>
        <p><span class="placeholder">[Draft — confirm the military-relocation copy with Kelly]</span></p>
      </div>
    </div>
  </section>

  <section class="aquote grid" aria-label="In Kelly’s words">
    <blockquote class="display aquote__text" data-reveal="lines">
      “If you are looking for an agent who is focused on you, stays on top of everything, is easy to get a hold
      of, and is attentive to your needs, then <em>I am your agent!</em>”
    </blockquote>
    <p class="label label--muted aquote__cite" data-reveal="fade">— {agent.name}</p>
  </section>

  <section class="areviews grid" aria-labelledby="reviews-title">
    <h2 id="reviews-title" class="label label--muted areviews__label">From clients</h2>
    <div class="areviews__slot">
      <p class="placeholder">[Client reviews — add two or three real, approved reviews with client permission]</p>
    </div>
  </section>

  <Contact />
</Base>

<style>
  .ahero {
    padding-top: calc(var(--header-h) + clamp(3rem, 8vw, 7rem));
    padding-bottom: clamp(4rem, 8vw, 7rem);
    row-gap: 1.5rem;
    align-items: end;
  }

  .ahero__kicker {
    grid-column: 1 / -1;
    color: var(--brick);
  }

  .ahero__title {
    grid-column: 1 / span 8;
    grid-row: 2;
    font-size: var(--step-5);
    line-height: 0.9;
    padding-bottom: 0.5rem;
  }

  .ahero__portrait {
    grid-column: 9 / -1;
    grid-row: 2;
  }

  .ahero__cap {
    margin-top: 0.9rem;
    line-height: 1.9;
  }

  .aletterbox__cap {
    margin-top: 0.9rem;
    text-align: right;
  }

  .astory {
    padding-block: clamp(5rem, 11vw, 10rem);
    align-items: start;
    row-gap: 2rem;
  }

  .astory__label {
    grid-column: 1 / span 3;
    padding-top: 0.8rem;
  }

  .astory__body {
    grid-column: 5 / span 7;
    display: grid;
    gap: 1.4rem;
    font-size: var(--step-1);
    line-height: 1.6;
    max-width: 40em;
  }

  .astory__p--lead {
    font-size: var(--step-2);
    line-height: 1.22;
    margin-bottom: 1rem;
  }

  .astory__sign {
    font-size: var(--step-2);
  }

  .apath {
    padding-bottom: clamp(6rem, 12vw, 11rem);
  }

  .apath__head {
    row-gap: 1rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .apath__label {
    grid-column: 1 / -1;
  }

  .apath__title {
    grid-column: 1 / span 9;
    font-size: var(--step-4);
  }

  .apath__list {
    margin: 0;
    row-gap: 0;
  }

  .apath__step {
    grid-column: span 4;
    display: grid;
    gap: 0.4rem;
    padding: 1.5rem 0 2.5rem;
    border-top: 1px solid var(--rule);
  }

  .apath__step:nth-child(3n + 2) {
    margin-top: clamp(0rem, 3vw, 3rem);
  }

  .apath__step:nth-child(3n + 3) {
    margin-top: clamp(0rem, 6vw, 6rem);
  }

  .apath__num {
    color: var(--brick);
  }

  .apath__what {
    font-size: var(--step-2);
    line-height: 1.1;
  }

  .amil {
    padding-block: clamp(6rem, 12vw, 11rem);
  }

  .amil .grid {
    row-gap: 1.5rem;
    align-items: start;
  }

  .amil__label {
    grid-column: 1 / -1;
  }

  .amil__title {
    grid-column: 1 / span 6;
    font-size: var(--step-4);
  }

  .amil__text {
    grid-column: 8 / -1;
    display: grid;
    gap: 1.25rem;
    padding-top: 0.75rem;
  }

  .aquote {
    padding-block: clamp(7rem, 14vw, 13rem) clamp(4rem, 8vw, 7rem);
  }

  .aquote__text {
    grid-column: 2 / span 10;
    margin: 0;
    font-size: var(--step-3);
    line-height: 1.04;
    text-indent: -0.35em;
  }

  .aquote__cite {
    grid-column: 2 / span 10;
    margin-top: 2rem;
  }

  .areviews {
    padding-bottom: clamp(6rem, 12vw, 10rem);
    align-items: start;
    row-gap: 1.25rem;
  }

  .areviews__label {
    grid-column: 1 / span 3;
  }

  .areviews__slot {
    grid-column: 5 / -1;
    padding: clamp(2rem, 5vw, 4rem);
    background: var(--paper);
  }

  @media (max-width: 63.99rem) {
    .ahero__title {
      grid-column: 1 / span 7;
    }

    .ahero__portrait {
      grid-column: 8 / -1;
    }

    .astory__label {
      grid-column: 1 / -1;
    }

    .astory__body {
      grid-column: 1 / span 10;
    }

    .apath__step {
      grid-column: span 6;
    }

    .apath__step:nth-child(n) {
      margin-top: 0;
    }

    .amil__title,
    .amil__text {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 47.99rem) {
    .ahero__title,
    .ahero__portrait {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .ahero__portrait {
      grid-column: 2 / -1;
      margin-top: 1.5rem;
    }

    :global(.aletterbox) {
      aspect-ratio: 4 / 3;
    }

    .astory__body {
      grid-column: 1 / -1;
    }

    .apath__title {
      grid-column: 1 / -1;
    }

    .apath__step {
      grid-column: 1 / -1;
    }

    .aquote__text,
    .aquote__cite {
      grid-column: 1 / -1;
    }

    .aquote__text {
      text-indent: 0;
    }

    .areviews__label,
    .areviews__slot {
      grid-column: 1 / -1;
    }
  }
</style>
