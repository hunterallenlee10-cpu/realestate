---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import Contact from '../../components/Contact.astro';
import { featured } from '../../data/listings';
import { idxDisclaimer } from '../../data/site';

export function getStaticPaths() {
  return [{ params: { slug: featured.slug } }];
}

const f = featured;
const fullAddress = `${f.street}, ${f.city}, ${f.state} ${f.zip}`;
---

<Base
  title={`${f.street}, ${f.city} — Kelly Robertson, Coldwell Banker Elite`}
  description={`${f.beds} beds, ${f.baths} baths, ${f.sqft} sq ft on ${f.acres} wooded acres in ${f.community}, ${f.county}. ${f.price}.`}
  image={f.hero.src}
>
  <section class="lhero" data-hero data-surface="dark" aria-labelledby="listing-title">
    <Photo
      src={f.hero.src}
      alt={f.hero.alt}
      ratio="fill"
      sizes="100vw"
      widths={[640, 960, 1280, 1600, 2000, 2400]}
      focus={f.hero.focus}
      kenburns="loop"
      quality={52}
      eager
    />
    <div class="lhero__scrim" aria-hidden="true"></div>
    <div class="lhero__content grid">
      <div class="lhero__copy">
        <p class="label intro-fade" style="--d: 500ms">{f.community} <span aria-hidden="true">·</span> {f.county}</p>
        <h1 id="listing-title" class="display lhero__title">
          <span class="intro-line"><span>{f.shortName}</span></span>
        </h1>
        <p class="serif lhero__town intro-fade" style="--d: 700ms"><em>{f.city}, Virginia</em></p>
      </div>
      <div class="lhero__meta intro-fade" style="--d: 1000ms">
        <p class="label lhero__status">{f.status}</p>
        <p class="serif lhero__price">{f.price}</p>
        <ul class="specs label" role="list">
          <li>{f.beds} Beds</li>
          <li>{f.baths} Baths</li>
          <li>{f.sqft} Sq Ft</li>
        </ul>
        <button class="lhero__toggle" type="button" aria-label="Pause background motion" data-hero-toggle>
          <Icon name="pause" class="hero__icon-pause" />
          <Icon name="play" class="hero__icon-play" />
          <span data-hero-toggle-text>Pause</span>
        </button>
      </div>
    </div>
  </section>

  <section class="lintro grid" aria-labelledby="story-title">
    <h2 id="story-title" class="label label--muted lintro__label" data-reveal="fade">The story</h2>
    <p class="serif lintro__story" data-reveal="lines">{f.story}</p>

    <dl class="facts" data-reveal="fade">
      {
        f.facts.map(([term, value]) => (
          <div class="facts__row">
            <dt class="label label--muted">{term}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="lintro__actions" data-reveal="fade">
      <a class="pill pill--solid" href="#contact">Schedule a showing <Icon name="arrow" /></a>
      <a class="link" href={f.virtualTour}>Virtual tour <Icon name="external" /></a>
      <a class="link" href={f.cbListing}>On coldwellbanker.com <Icon name="external" /></a>
    </div>
  </section>

  {
    f.chapters.map((c) => (
      <section class={`lchapter lchapter--${c.layout}`} aria-labelledby={`chapter-${c.numeral}`}>
        <header class="lchapter__head grid">
          <p class="label lchapter__numeral" data-reveal="fade">
            Chapter {c.numeral}
          </p>
          <h2 id={`chapter-${c.numeral}`} class="display lchapter__title" data-reveal="lines">
            {c.title}
          </h2>
          <p class="lead lchapter__text" data-reveal="fade">
            {c.text}
          </p>
        </header>

        <div class="lchapter__photos grid">
          {c.photos.map((p, i) => {
            const isLetterbox = (c.layout === 'porch' || c.layout === 'land') && i === 0;
            if (isLetterbox) {
              return (
                <Photo
                  src={p.src}
                  alt={p.alt}
                  ratio="letterbox"
                  sizes="100vw"
                  widths={[640, 960, 1280, 1600, 2000, 2400]}
                  focus={p.focus}
                  reveal="wipe"
                  kenburns="scroll"
                  class="lchapter__letterbox"
                />
              );
            }
            const ratio = c.layout === 'rooms' ? (['landscape', 'portrait', 'wide'] as const)[i] : c.layout === 'retreat' ? (['landscape', 'portrait'] as const)[i] : (['landscape', 'portrait', 'landscape'] as const)[i];
            return (
              <figure class={`lphoto lphoto--${i + 1}`}>
                <Photo
                  src={p.src}
                  alt={p.alt}
                  ratio={ratio}
                  sizes="(max-width: 47.99rem) 100vw, 60vw"
                  widths={[480, 800, 1200, 1600, 2000]}
                  focus={p.focus}
                  reveal="wipe"
                />
                {p.caption && <figcaption class="label label--muted">{p.caption}</figcaption>}
              </figure>
            );
          })}
        </div>
      </section>
    ))
  }

  <section class="lnotes grid" aria-labelledby="notes-title">
    <h2 id="notes-title" class="visually-hidden">Location and listing notes</h2>
    <div class="lnotes__col" data-reveal="fade">
      <h3 class="label label--muted">Getting around</h3>
      <ul role="list" class="lnotes__list">
        {f.gettingAround.map((line) => <li>{line}</li>)}
      </ul>
    </div>
    <div class="lnotes__col" data-reveal="fade">
      <h3 class="label label--muted">Financing note</h3>
      <p>{f.financingNote}</p>
    </div>
    <div class="lnotes__col lnotes__attr" data-reveal="fade">
      <h3 class="label label--muted">Listing</h3>
      <p>{fullAddress}</p>
      <p>MLS# {f.mls} · Listed by {f.listedBy}</p>
      <p>Photography: {f.photographer} <span class="placeholder">[Confirm photo usage rights]</span></p>
      <p class="muted">{idxDisclaimer}</p>
    </div>
  </section>

  <Contact listing={fullAddress} />
</Base>

<style>
  /* ---- Hero ---- */
  .lhero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    background: var(--ink);
    color: var(--ivory);
    isolation: isolate;
  }

  .lhero > :global(.frame) {
    z-index: -2;
    background: var(--ink);
  }

  .lhero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* same tuned legibility scrim as the homepage hero */
    background:
      linear-gradient(
        to bottom,
        rgb(20 18 15 / 0.72) 0,
        rgb(20 18 15 / 0.62) 6.5rem,
        rgb(20 18 15 / 0.2) 12rem,
        rgb(20 18 15 / 0) 17rem
      ),
      linear-gradient(to top, rgb(20 18 15 / 0.8), rgb(20 18 15 / 0.5) 34%, rgb(20 18 15 / 0.16) 56%, rgb(20 18 15 / 0) 70%);
  }

  .lhero__content {
    position: absolute;
    inset: auto 0 0;
    align-items: end;
    padding-bottom: clamp(1.75rem, 5vh, 3.75rem);
  }

  .lhero__copy {
    grid-column: 1 / span 9;
  }

  .lhero__title {
    margin-top: 1rem;
    font-size: min(clamp(3.4rem, 0.6rem + 11vw, 12.5rem), 17vh);
    line-height: 0.86;
    letter-spacing: -0.02em;
  }

  .lhero__town {
    margin-top: 0.5rem;
    font-size: var(--step-2);
  }

  .lhero__meta {
    grid-column: 10 / -1;
    justify-self: end;
    text-align: right;
  }

  .lhero__meta .specs {
    justify-content: flex-end;
  }

  .lhero__status {
    color: rgb(247 243 236 / 0.85);
  }

  .lhero__price {
    margin: 0.3rem 0 0.5rem;
    font-size: var(--step-3);
    line-height: 1;
  }

  .lhero__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    margin-top: 0.4rem;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .lhero__toggle :global(.icon) {
    width: 1rem;
    height: 1rem;
  }

  .lhero__toggle :global(.hero__icon-play),
  .lhero[data-paused='true'] .lhero__toggle :global(.hero__icon-pause) {
    display: none;
  }

  .lhero[data-paused='true'] .lhero__toggle :global(.hero__icon-play) {
    display: block;
  }

  .lhero :focus-visible {
    outline-color: var(--ivory);
  }

  @media (prefers-reduced-motion: reduce) {
    .lhero__toggle {
      display: none;
    }
  }

  /* ---- Story + facts ---- */
  .lintro {
    padding-block: clamp(6rem, 12vw, 11rem);
    row-gap: 3rem;
    align-items: start;
  }

  .lintro__label {
    grid-column: 1 / span 3;
    padding-top: 0.8rem;
  }

  .lintro__story {
    grid-column: 4 / -1;
    font-size: clamp(1.6rem, 1.05rem + 2.1vw, 3rem);
    line-height: 1.16;
    text-indent: 2em;
  }

  .facts {
    grid-column: 4 / span 6;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gutter);
    margin-top: clamp(1rem, 3vw, 2.5rem);
  }

  .facts__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .facts__row dd {
    text-align: right;
  }

  .lintro__actions {
    grid-column: 4 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2.25rem;
  }

  /* ---- Chapters ---- */
  .lchapter {
    padding-bottom: clamp(6rem, 12vw, 11rem);
  }

  .lchapter__head {
    row-gap: 1rem;
    padding-bottom: clamp(3rem, 6vw, 5.5rem);
    align-items: end;
  }

  .lchapter__numeral {
    grid-column: 1 / -1;
    color: var(--brick);
  }

  .lchapter__title {
    grid-column: 1 / span 6;
    font-size: var(--step-5);
    line-height: 0.9;
  }

  .lchapter__text {
    grid-column: 8 / span 5;
    padding-bottom: 0.6rem;
  }

  .lchapter__photos {
    row-gap: clamp(3rem, 7vw, 6rem);
    align-items: start;
  }

  .lchapter__photos > :global(.lchapter__letterbox) {
    grid-column: 1 / -1;
    margin-inline: calc(var(--margin) * -1);
  }

  .lphoto figcaption {
    margin-top: 0.9rem;
  }

  /* porch: letterbox, then a portrait and a landscape, staggered */
  .lchapter--porch .lphoto--2 {
    grid-column: 2 / span 4;
  }

  .lchapter--porch .lphoto--3 {
    grid-column: 7 / -1;
    margin-top: clamp(4rem, 14vw, 13rem);
  }

  /* rooms: large left, tall right (dropped), wide centred */
  .lchapter--rooms .lphoto--1 {
    grid-column: 1 / span 8;
  }

  .lchapter--rooms .lphoto--2 {
    grid-column: 9 / -1;
    margin-top: clamp(3rem, 12vw, 11rem);
  }

  .lchapter--rooms .lphoto--3 {
    grid-column: 4 / span 7;
  }

  /* retreat: portrait left (dropped), landscape right */
  .lchapter--retreat .lphoto--1 {
    grid-column: 5 / -1;
    grid-row: 1;
  }

  .lchapter--retreat .lphoto--2 {
    grid-column: 1 / span 4;
    grid-row: 1;
    margin-top: clamp(4rem, 16vw, 15rem);
  }

  /* land: letterbox, then landscape + tall */
  .lchapter--land .lphoto--2 {
    grid-column: 1 / span 6;
  }

  .lchapter--land .lphoto--3 {
    grid-column: 8 / span 4;
    margin-top: clamp(3rem, 10vw, 9rem);
  }

  /* ---- Notes ---- */
  .lnotes {
    padding-block: clamp(4rem, 8vw, 7rem) clamp(6rem, 11vw, 10rem);
    border-top: 1px solid var(--rule);
    row-gap: 2.5rem;
    align-items: start;
  }

  .lnotes__col {
    grid-column: span 4;
    display: grid;
    gap: 0.7rem;
    font-size: 0.9375rem;
  }

  .lnotes__list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding-left: 1.1em;
  }

  .lnotes__attr p {
    line-height: 1.55;
  }

  .lnotes__attr .muted {
    font-size: 0.8125rem;
  }

  @media (max-width: 63.99rem) {
    .lintro__label {
      grid-column: 1 / -1;
    }

    .lintro__story,
    .lintro__actions {
      grid-column: 1 / -1;
    }

    .facts {
      grid-column: 1 / span 9;
    }

    .lchapter__title {
      grid-column: 1 / -1;
    }

    .lchapter__text {
      grid-column: 1 / span 9;
    }

    .lnotes__col {
      grid-column: span 6;
    }

    .lnotes__attr {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 47.99rem) {
    .lhero__copy,
    .lhero__meta {
      grid-column: 1 / -1;
    }

    .lhero__meta {
      justify-self: start;
      text-align: left;
      margin-top: 1.5rem;
      padding-top: 1rem;
      border-top: 1px solid rgb(247 243 236 / 0.3);
    }

    .lhero__meta .specs {
      justify-content: flex-start;
    }

    .facts {
      grid-column: 1 / -1;
      grid-template-columns: 1fr;
    }

    .lchapter__text {
      grid-column: 1 / -1;
    }

    .lchapter__photos > :global(.lchapter__letterbox) {
      aspect-ratio: 4 / 5;
    }

    .lchapter--porch .lphoto--2,
    .lchapter--rooms .lphoto--2,
    .lchapter--retreat .lphoto--2,
    .lchapter--land .lphoto--3 {
      grid-column: 1 / span 5;
      margin-top: 0;
    }

    .lchapter--porch .lphoto--3,
    .lchapter--rooms .lphoto--1,
    .lchapter--rooms .lphoto--3,
    .lchapter--retreat .lphoto--1,
    .lchapter--land .lphoto--2 {
      grid-column: 1 / -1;
      grid-row: auto;
      margin-top: 0;
    }

    .lchapter--retreat .lphoto--2 {
      grid-row: auto;
      grid-column: 2 / -1;
    }

    .lnotes__col {
      grid-column: 1 / -1;
    }
  }
</style>
